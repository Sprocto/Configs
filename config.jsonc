// -*- mode: jsonc -*-
{

    "height": 30,

    "spacing": 4, 

    "margin-top": 5,
    "margin-left": 5,
    "margin-right": 5,

    "modules-left": [
        "custom/launcher",
        "custom/weather",
        "custom/cmus",
        "cava",
    ],
    "modules-center": [
        "hyprland/window",
    ],
    "modules-right": [
        "pulseaudio",
        "cpu",
        "memory",
        "temperature",
        "clock",
    ],
    "clock": {
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%Y-%m-%d}"
    },
    "cava": {
    "framerate": 90,
    "autosens": 1,
    "sensitivity": 2,
    "bars": 24,
    "lower_cutoff_freq": 50,
    "higher_cutoff_freq": 10000,
    "method": "pipewire",
    "source": "auto",
    "stereo": true,
    "reverse": false,
    "bar_delimiter": 0,
    "monstercat": true,
    "waves": true,
    "noise_reduction": 0.77,
    "input_delay": 2,
    "hide_on_silence": true,
    "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"]
    },
    "cpu": {
        "format": "{usage}% ",
        "tooltip": false
    },
    "memory": {
        "format": "{}% "
    },
    "temperature": {
        "critical-threshold": 80,
        "format": "{temperatureC}°C {icon}",
        "format-icons": ["󰉬", "", "󰉪"]
    },
    "custom/weather": {
     "format": "{}°",
     "tooltip": true,
     "interval": 3600,
     "exec": "wttrbar",
     "return-type": "json"
    },
    "custom/cmus": {
     "format": "♪ {text}",
     "interval": 2,
     "exec": "cmus-remote -C \"format_print '%a - %t'\"",
     "exec-if": "pgrep cmus",
     "on-click": "cmus-remote -u",
     "escape": true
    },
    "custom/launcher": {
     "format": "",
     "on-click": "hyprlauncher",
    },
    "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-bluetooth": "{icon} {volume}% ",
    "format-muted": " Muted",
    "format-icons": {
      "headphone": " ",
      "hands-free": " ",
      "headset": " ",
      "phone": " ",
      "portable": " ",
      "car": " ",
      "default": [" ", " "]
    },
    "on-click": "pavucontrol"
  },
}
